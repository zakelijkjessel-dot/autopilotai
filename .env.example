# ============================
# Twilio (WhatsApp)
# ============================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Twilio Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ============================
# Anthropic (Claude AI)
# ============================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ============================
# E-mail (SMTP)
# Tip: gebruik een Gmail App Password
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jouw_email@gmail.com
SMTP_PASSWORD=jouw_app_wachtwoord
SMTP_FROM=AutoGarage <jouw_email@gmail.com>

# ============================
# Garage Informatie
# ============================
GARAGE_NAAM=AutoGarage Nederland
GARAGE_ADRES=Hoofdstraat 1, 1234 AB Amsterdam
GARAGE_TELEFOON=+31 20 123 4567
GARAGE_EMAIL=info@autogarage.nl

# ============================
# Applicatie
# ============================
DATABASE_URL=sqlite:///./garage.db
BASE_URL=http://localhost:8000

# Optioneel
ANTHROPIC_MODEL=claude-sonnet-4-6
TIMEZONE=Europe/Amsterdam
# Alleen lokaal aanzetten: /debug en /dev/test-message
ENABLE_DEV_ROUTES=false
# Web-chat (/chat). Lokaal op true zetten om te testen; in productie false laten.
ENABLE_WEB_CHAT=false

# Admin-dashboard (/admin). Zonder ADMIN_PASSWORD is het dashboard uitgeschakeld.
ADMIN_USER=admin
ADMIN_PASSWORD=kies-een-lang-wachtwoord
